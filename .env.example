# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=       # server-only, never in NEXT_PUBLIC_

# Sentry
SENTRY_DSN=
SENTRY_AUTH_TOKEN=               # build-time for source maps

# Worker
WORKER_ID=worker-1
WORKER_POLL_INTERVAL_MS=1000
WORKER_HEALTH_PORT=8081

# Source API Keys
FRED_API_KEY=                    # https://fredaccount.stlouisfed.org/apikeys
CONGRESS_GOV_API_KEY=            # https://api.congress.gov/sign-up/
FEC_API_KEY=DEMO_KEY             # https://api.open.fec.gov/developers/

# LLM (comma-separated for rotation)
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.1-flash-lite-preview

# Email
RESEND_API_KEY=                  # https://resend.com

# Tavily (comma-separated for rotation)
TAVILY_API_KEYS=

# Firecrawl (comma-separated for rotation)
FIRECRAWL_API_KEYS=

# Cron
CRON_SECRET=                     # shared secret for /api/cron/sync

# General
LOG_LEVEL=info
NODE_ENV=development
